{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(./gradlew test)",
      "Bash(./gradlew test:*)",
      "Bash(./gradlew build)",
      "Bash(./gradlew compileJava)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(docker ps:*)",
      "Bash(curl -s http://localhost:8080/*)",
      "Bash(node .agents/scripts/sync-mcp.mjs:*)"
    ],
    "deny": [
      "Edit(src/main/resources/static/**)",
      "Write(src/main/resources/static/**)",
      "Edit(docs/images/**)",
      "Write(docs/images/**)",
      "Write(.mcp.json)",
      "Bash(git push:*)",
      "Bash(docker rm:*)",
      "Bash(docker volume rm:*)"
    ]
  }
}
