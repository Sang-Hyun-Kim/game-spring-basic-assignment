# 이 파일을 .env 로 복사한 뒤 값을 채운다. .env 는 커밋하지 않는다.
#   cp docker/.env.example docker/.env
#
# 여기가 접속 정보의 단일 진실 공급원이다.
# application.properties 의 datasource 도 반드시 이 값과 맞춘다.

MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=crimson_citadel
# 3306 = 네이티브 MySQL80, 3307 = infra(AI_MMORPG). 바꾸려면 충돌부터 확인할 것.
MYSQL_HOST_PORT=3308
